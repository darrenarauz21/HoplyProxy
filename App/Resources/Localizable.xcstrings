            "state": "translated",
            "value": "Continuer écran verrouillé"
          }
        }
      }
    },
    "settings.behavior.footer": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con el modo en segundo plano, Hoply reproduce audio en silencio para que iOS no suspenda la app al bloquear la pantalla. No pide ningún permiso y consume más batería. El recordatorio llega un día antes de que caduque la firma."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With background mode, Hoply plays silent audio so iOS does not suspend the app when the screen locks. It asks for no permission and uses more battery. The reminder arrives one day before the signature expires."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com o modo em segundo plano, o Hoply reproduz um áudio silencioso para que o iOS não suspenda o app ao bloquear a tela. Não pede nenhuma permissão e consome mais bateria. O lembrete chega um dia antes de a assinatura expirar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec le mode arrière-plan, Hoply joue un son silencieux pour qu’iOS ne suspende pas l’app quand l’écran se verrouille. Il ne demande aucune autorisation et consomme plus de batterie. Le rappel arrive un jour avant l’expiration de la signature."
          }
        }
      }
    },
    "settings.behavior.reminder": {
      "extractionState": "manual",
      "localizations": {
