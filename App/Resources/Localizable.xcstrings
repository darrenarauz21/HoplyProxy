    "settings.auth.footer": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La contraseña se guarda en el Keychain del iPhone. Con el proxy HTTP, los navegadores piden las credenciales; con SOCKS5, solo los clientes que admiten autenticación."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The password is stored in the iPhone Keychain. With the HTTP proxy, browsers ask for the credentials; with SOCKS5, only clients that support authentication."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A senha fica guardada nas Chaves (Keychain) do iPhone. Com o proxy HTTP, os navegadores pedem as credenciais; com SOCKS5, só os clientes que suportam autenticação."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mot de passe est enregistré dans le trousseau de l’iPhone. Avec le proxy HTTP, les navigateurs demandent les identifiants ; avec SOCKS5, seulement les clients qui gèrent l’authentification."
          }
        }
      }
    },
