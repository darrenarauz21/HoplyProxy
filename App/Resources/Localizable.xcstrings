    "docs.desktop.download": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descárgala de la sección **Releases** del repositorio de GitHub, o ejecuta el workflow **Build Desktop** en la pestaña **Actions** de tu fork. Es un único ejecutable por sistema."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download it from the repository's **Releases** on GitHub, or run the **Build Desktop** workflow in your fork's **Actions** tab. It's a single executable per system."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixe na seção **Releases** do repositório no GitHub ou execute o workflow **Build Desktop** na aba **Actions** do seu fork. É um único executável por sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargez-la depuis les **Releases** du dépôt sur GitHub, ou lancez le workflow **Build Desktop** dans l’onglet **Actions** de votre fork. C’est un seul exécutable par système."
          }
        }
      }
    },
    "docs.desktop.download.title": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descargar"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Download"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargement"
          }
        }
      }
    },
    "docs.desktop.intro": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoply Desktop hace la parte de la laptop por ti: reenvía la conexión por el cable, activa el proxy del sistema y lo deja como estaba al desconectar. Funciona en Windows, macOS y Linux, y no necesita Node.js ni go-ios."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoply Desktop handles the laptop side for you: it forwards the connection over the cable, turns on the system proxy and restores it when you disconnect. It runs on Windows, macOS and Linux and needs neither Node.js nor go-ios."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Hoply Desktop cuida da parte do laptop para você: encaminha a conexão pelo cabo, ativa o proxy do sistema e o restaura quando você desconecta. Funciona no Windows, macOS e Linux e não precisa de Node.js nem go-ios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoply Desktop s’occupe du côté ordinateur pour vous : il fait passer la connexion par le câble, active le proxy du système et le rétablit à la déconnexion. Il fonctionne sous Windows, macOS et Linux, sans Node.js ni go-ios."
          }
        }
      }
    },
    "docs.desktop.requirements.linux": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Linux:** el paquete usbmuxd para USB. El proxy del sistema se configura en escritorios GNOME."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Linux:** the usbmuxd package for USB. The system proxy is configured on GNOME desktops."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "**Linux:** o pacote usbmuxd para USB. O proxy do sistema é configurado em desktops GNOME."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Linux :** le paquet usbmuxd pour l’USB. Le proxy du système est configuré sur les bureaux GNOME."
          }
        }
      }
    },
    "docs.desktop.requirements.macos": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**macOS:** nada adicional. La primera vez, ábrela con clic derecho > Abrir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**macOS:** nothing else. The first time, open it with right-click > Open."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "**macOS:** nada mais. Na primeira vez, abra com o botão direito > Abrir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**macOS :** rien de plus. La première fois, ouvrez-la avec clic droit > Ouvrir."
          }
        }
      }
    },
    "docs.desktop.requirements.title": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Requisitos"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requirements"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Requisitos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuration requise"
          }
        }
      }
    },
    "docs.desktop.requirements.windows": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Windows:** la app Apple Devices o iTunes, para que el sistema reconozca el iPhone por cable."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Windows:** the Apple Devices app or iTunes, so the system recognizes the iPhone over the cable."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "**Windows:** o app Dispositivos Apple ou o iTunes, para que o sistema reconheça o iPhone pelo cabo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Windows :** l’app Appareils Apple ou iTunes, pour que le système reconnaisse l’iPhone par le câble."
          }
        }
      }
    },
    "docs.desktop.summary": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta la laptop con un clic"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect the laptop in one click"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte o laptop com um clique"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez l’ordinateur en un clic"
          }
        }
      }
    },
