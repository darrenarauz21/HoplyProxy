          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale o go-ios (requer Node.js) ou baixe o binário no GitHub:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
