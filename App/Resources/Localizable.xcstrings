    "settings.behavior.background": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguir activo con la pantalla bloqueada"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep running with the screen locked"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuar com a tela bloqueada"
          }
        },
        "fr": {
