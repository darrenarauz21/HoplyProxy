    "guide.joinSameWiFi": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta la laptop a la misma red Wi-Fi que el iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect the laptop to the same Wi-Fi network as the iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte o laptop à mesma rede Wi-Fi do iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez l’ordinateur au même réseau Wi-Fi que l’iPhone."
          }
        }
      }
    },
    "guide.pac.linux": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Configuración > Red > Proxy de red, elige «Automático» y pega esta dirección:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Settings > Network > Network Proxy, choose “Automatic” and paste this address:"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em Configurações > Rede > Proxy de rede, escolha “Automático” e cole este endereço:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Paramètres > Réseau > Serveur mandataire, choisissez « Automatique » et collez cette adresse :"
          }
        }
      }
    },
    "guide.pac.macOS": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Ajustes del Sistema > Red > Detalles > Proxies, activa «Configuración automática de proxy» y pega esta dirección:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In System Settings > Network > Details > Proxies, turn on “Automatic proxy configuration” and paste this address:"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em Ajustes do Sistema > Rede > Detalhes > Proxies, ative “Configuração automática de proxy” e cole este endereço:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Réglages Système > Réseau > Détails > Proxys, activez « Configuration automatique du proxy » et collez cette adresse :"
          }
        }
      }
    },
    "guide.pac.windows": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Configuración > Red e Internet > Proxy, activa «Usar script de instalación» y pega esta dirección:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Settings > Network & Internet > Proxy, turn on “Use setup script” and paste this address:"
          }
        },
        "pt-BR": {
