    "guide.connectCable": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta el iPhone a la laptop con el cable y toca «Confiar» si aparece el aviso."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect the iPhone to the laptop with the cable and tap “Trust” if prompted."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte o iPhone ao laptop com o cabo e toque em “Confiar” se aparecer o aviso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Branchez l’iPhone à l’ordinateur avec le câble et touchez « Se fier » si on vous le demande."
          }
        }
      }
    },
    "guide.enterCredentials %@": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El navegador o el sistema pedirán usuario y contraseña la primera vez. Usuario: %@. La contraseña está en Ajustes."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The browser or the system will ask for a username and password the first time. Username: %@. The password is in Settings."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O navegador ou o sistema pedirá usuário e senha na primeira vez. Usuário: %@. A senha está em Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le navigateur ou le système demandera un nom d’utilisateur et un mot de passe la première fois. Utilisateur : %@. Le mot de passe se trouve dans Réglages."
          }
        }
      }
    },
    "guide.firefox": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Firefox puedes configurarlo aparte: Ajustes > Configuración de red > Configuración manual del proxy > Proxy HTTP con esta dirección, y marca «Usar también este proxy para HTTPS»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Firefox you can set it separately: Settings > Network Settings > Manual proxy configuration > HTTP Proxy with this address, and check “Also use this proxy for HTTPS”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No Firefox você pode configurá-lo à parte: Configurações > Configurações de rede > Configuração manual de proxy > Proxy HTTP com este endereço, e marque “Usar também este proxy para HTTPS”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Firefox, vous pouvez le régler à part : Paramètres > Paramètres réseau > Configuration manuelle du proxy > Proxy HTTP avec cette adresse, puis cochez « Utiliser également ce proxy pour HTTPS »."
          }
        }
      }
    },
    "guide.installAppleDevices": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala la app Apple Devices (o iTunes) para que Windows reconozca el iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install the Apple Devices app (or iTunes) so Windows recognizes the iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale o app Dispositivos Apple (ou o iTunes) para que o Windows reconheça o iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez l’app Appareils Apple (ou iTunes) pour que Windows reconnaisse l’iPhone."
          }
        }
      }
    },
    "guide.installGoIos": {
