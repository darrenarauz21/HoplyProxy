    "docs.desktop.use.1": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia el proxy en esta app."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start the proxy in this app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie o proxy neste app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrez le proxy dans cette app."
          }
        }
      }
    },
    "docs.desktop.use.2": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la laptop, elige **USB** o **Wi-Fi**. En Wi-Fi, escribe la IP que aparece en la tarjeta Conexión."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the laptop, choose **USB** or **Wi-Fi**. For Wi-Fi, enter the IP shown on the Connection card."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No laptop, escolha **USB** ou **Wi-Fi**. Para Wi-Fi, digite o IP mostrado no cartão Conexão."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur l’ordinateur, choisissez **USB** ou **Wi-Fi**. En Wi-Fi, saisissez l’IP affichée dans la carte Connexion."
          }
        }
      }
    },
    "docs.desktop.use.3": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa **Conectar**. Cuando todo funciona, la app muestra tu IP pública."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click **Connect**. When everything works, the app shows your public IP."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em **Conectar**. Quando tudo funcionar, o app mostra seu IP público."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur **Connecter**. Quand tout fonctionne, l’app affiche votre IP publique."
          }
        }
      }
    },
    "docs.desktop.use.4": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa **Desconectar** o cierra la ventana para dejar la laptop como estaba."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click **Disconnect** or close the window to leave the laptop as it was."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em **Desconectar** ou feche a janela para deixar o laptop como estava."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur **Déconnecter** ou fermez la fenêtre pour remettre l’ordinateur dans son état initial."
          }
        }
      }
    },
    "docs.desktop.use.title": {
      "extractionState": "manual",
      "localizations": {
