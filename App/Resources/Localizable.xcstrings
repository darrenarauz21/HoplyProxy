    "docs.modes.summary": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuál elegir y qué necesita cada uno"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which to choose and what each needs"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual escolher e o que cada um precisa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lequel choisir et ce qu’il faut pour chacun"
          }
        }
      }
    },
    "docs.modes.title": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "USB o Wi-Fi"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "USB or Wi-Fi"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "USB ou Wi-Fi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "USB ou Wi-Fi"
          }
        }
      }
    },
    "docs.modes.usb": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La laptop llega al iPhone por el cable. Es la opción más estable y privada: el proxy solo escucha dentro del iPhone y nadie más en la red puede usarlo. Necesita la app de escritorio o go-ios en la laptop."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The laptop reaches the iPhone through the cable. It's the most stable and private option: the proxy only listens inside the iPhone and nobody else on the network can use it. It needs the desktop app or go-ios on the laptop."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O laptop chega ao iPhone pelo cabo. É a opção mais estável e privada: o proxy só escuta dentro do iPhone e ninguém mais na rede pode usá-lo. Requer o app para computador ou o go-ios no laptop."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ordinateur atteint l’iPhone par le câble. C’est l’option la plus stable et la plus privée : le proxy n’écoute qu’à l’intérieur de l’iPhone et personne d’autre sur le réseau ne peut l’utiliser. Il faut l’app pour ordinateur ou go-ios."
          }
        }
      }
    },
    "docs.modes.wifi": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La laptop se conecta a la IP del iPhone en la red Wi-Fi. No necesita cable ni programas adicionales, pero ambos deben estar en la misma red."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The laptop connects to the iPhone's IP on the Wi-Fi network. No cable or extra software is needed, but both must be on the same network."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O laptop se conecta ao IP do iPhone na rede Wi-Fi. Não precisa de cabo nem de software extra, mas os dois devem estar na mesma rede."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ordinateur se connecte à l’IP de l’iPhone sur le réseau Wi-Fi. Ni câble ni logiciel supplémentaire, mais les deux doivent être sur le même réseau."
          }
        }
      }
    },
    "docs.modes.wifi.clients": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo responden los equipos autorizados en **Ajustes > Clientes autorizados**. El asistente autoriza la red actual."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only devices allowed in **Settings > Authorized clients** get a response. The assistant allows the current network."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só os dispositivos permitidos em **Ajustes > Clientes autorizados** recebem resposta. O assistente permite a rede atual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les appareils autorisés dans **Réglages > Clients autorisés** obtiennent une réponse. L’assistant autorise le réseau actuel."
          }
        }
      }
    },
    "docs.modes.wifi.localNetwork": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS pide permiso de **Red local** la primera vez. Si lo negaste, actívalo en Ajustes > Privacidad > Red local."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS asks for **Local Network** permission the first time. If you denied it, turn it on in Settings > Privacy > Local Network."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS pede a permissão de **Rede Local** na primeira vez. Se você negou, ative-a em Ajustes > Privacidade > Rede Local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS demande l’autorisation **Réseau local** la première fois. Si vous l’avez refusée, activez-la dans Réglages > Confidentialité > Réseau local."
          }
        }
      }
    },
    "docs.modes.wifi.trusted": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tráfico entre la laptop y el iPhone no va cifrado: usa Wi-Fi solo en redes de confianza."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Traffic between the laptop and the iPhone isn't encrypted: use Wi-Fi only on trusted networks."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tráfego entre o laptop e o iPhone não é criptografado: use o Wi-Fi apenas em redes confiáveis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le trafic entre l’ordinateur et l’iPhone n’est pas chiffré : n’utilisez le Wi-Fi que sur des réseaux de confiance."
          }
        }
      }
    },
    "docs.privacy.carrier": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa las condiciones de tu plan móvil: algunos operadores limitan o prohíben compartir datos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your mobile plan's terms: some carriers limit or forbid sharing data."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confira as condições do seu plano móvel: algumas operadoras limitam ou proíbem o compartilhamento de dados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez les conditions de votre forfait mobile : certains opérateurs limitent ou interdisent le partage de données."
          }
        }
      }
    },
    "docs.privacy.noTracking": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app no envía datos a ningún servidor ni registra los sitios que visitas."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app sends no data to any server and doesn't log the sites you visit."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app não envia dados a nenhum servidor nem registra os sites que você visita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app n’envoie aucune donnée à aucun serveur et n’enregistre pas les sites que vous visitez."
          }
        }
      }
    },
    "docs.privacy.password": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La contraseña, si la activas, se guarda en el Keychain del iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The password, if you turn it on, is stored in the iPhone's Keychain."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A senha, se você a ativar, fica guardada nas Chaves (Keychain) do iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mot de passe, si vous l’activez, est enregistré dans le trousseau de l’iPhone."
          }
        }
      }
    },
    "docs.privacy.summary": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué se comparte y con quién"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is shared and with whom"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que é compartilhado e com quem"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui est partagé et avec qui"
          }
        }
      }
    },
    "docs.privacy.title": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacidad y seguridad"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy and security"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacidade e segurança"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confidentialité et sécurité"
          }
        }
      }
    },
    "docs.privacy.unencrypted": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre la laptop y el iPhone el tráfico no va cifrado; los sitios HTTPS siguen cifrados de punta a punta."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Traffic between the laptop and the iPhone isn't encrypted; HTTPS sites stay encrypted end to end."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tráfego entre o laptop e o iPhone não é criptografado; os sites HTTPS continuam criptografados de ponta a ponta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le trafic entre l’ordinateur et l’iPhone n’est pas chiffré ; les sites HTTPS restent chiffrés de bout en bout."
          }
        }
      }
    },
    "docs.privacy.usb": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por USB, el proxy solo es accesible desde la laptop conectada al cable."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Over USB, the proxy is only reachable from the laptop on the cable."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por USB, o proxy só é acessível pelo laptop conectado ao cabo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En USB, le proxy n’est accessible que depuis l’ordinateur branché au câble."
          }
        }
      }
    },
    "docs.privacy.wifi": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por Wi-Fi, solo responde a los equipos autorizados y nunca escucha en la red móvil."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Over Wi-Fi, it only answers allowed devices and never listens on the mobile network."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por Wi-Fi, só responde aos dispositivos permitidos e nunca escuta na rede móvel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En Wi-Fi, il ne répond qu’aux appareils autorisés et n’écoute jamais sur le réseau mobile."
          }
        }
      }
    },
    "docs.renewal.auto.fallback": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si alguna vez falla, el recordatorio de Hoply te avisa a tiempo para renovarla a mano."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If it ever fails, Hoply's reminder warns you in time to renew it by hand."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se algum dia falhar, o lembrete do Hoply avisa a tempo para você renovar manualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si jamais ça échoue, le rappel de Hoply vous prévient à temps pour la renouveler à la main."
          }
        }
      }
    },
    "docs.renewal.auto.intro": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sideloadly puede renovarla solo cuando el iPhone y la computadora están en la misma red Wi-Fi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sideloadly can renew it on its own when the iPhone and the computer are on the same Wi-Fi network."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sideloadly pode renovar sozinho quando o iPhone e o computador estão na mesma rede Wi-Fi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sideloadly peut la renouveler tout seul quand l’iPhone et l’ordinateur sont sur le même réseau Wi-Fi."
          }
        }
      }
    },
    "docs.renewal.auto.step.1": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al instalar **Hoply.ipa**, activa la renovación automática con el ícono de actualizar, abajo a la izquierda en Sideloadly."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you install **Hoply.ipa**, turn on automatic refresh with the refresh icon at the bottom left of Sideloadly."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao instalar **Hoply.ipa**, ative a renovação automática com o ícone de atualizar, no canto inferior esquerdo do Sideloadly."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En installant **Hoply.ipa**, activez le renouvellement automatique avec l’icône d’actualisation, en bas à gauche de Sideloadly."
          }
        }
      }
    },
    "docs.renewal.auto.step.2": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja que Sideloadly se abra al iniciar la computadora: su servicio queda junto al reloj y es el que renueva."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let Sideloadly open when the computer starts: its background service sits next to the clock and does the renewal."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe o Sideloadly abrir ao iniciar o computador: o serviço dele fica ao lado do relógio e é quem renova."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez Sideloadly s’ouvrir au démarrage de l’ordinateur : son service reste près de l’horloge et s’occupe du renouvellement."
          }
        }
      }
    },
    "docs.renewal.auto.step.3": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con los dos en la misma red, renueva unos días antes de que caduque. Si el iPhone no tiene activado el acceso por Wi-Fi, lo hace por cable cuando lo conectas."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With both on the same network, it renews a few days before expiry. If Wi-Fi access isn't enabled on the iPhone, it uses the cable when you plug it in."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com os dois na mesma rede, renova alguns dias antes de expirar. Se o acesso por Wi-Fi não estiver ativado no iPhone, usa o cabo quando você o conecta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec les deux sur le même réseau, il renouvelle quelques jours avant l’expiration. Si l’accès Wi-Fi n’est pas activé sur l’iPhone, il passe par le câble quand vous le branchez."
          }
        }
      }
    },
    "docs.renewal.auto.title": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Renovación automática por Wi-Fi"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic renewal over Wi-Fi"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Renovação automática por Wi-Fi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renouvellement automatique en Wi-Fi"
          }
        }
      }
    },
    "docs.renewal.intro": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un Apple ID gratuito, iOS deja de abrir la app 7 días después de instalarla. Tus ajustes se conservan al renovarla."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With a free Apple ID, iOS stops opening the app 7 days after it was installed. Your settings are kept when you renew it."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com um Apple ID gratuito, o iOS deixa de abrir o app 7 dias após a instalação. Seus ajustes são mantidos ao renovar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec un identifiant Apple gratuit, iOS n’ouvre plus l’app 7 jours après son installation. Vos réglages sont conservés lors du renouvellement."
          }
        }
      }
    },
    "docs.renewal.reminder": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa **Ajustes > Recordarme renovar la firma** para recibir un aviso antes de que caduque."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on **Settings > Remind me to renew the signature** to get a notice before it expires."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative **Ajustes > Lembrar de renovar a assinatura** para receber um aviso antes que expire."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez **Réglages > Me rappeler de renouveler la signature** pour être prévenu avant l’expiration."
          }
        }
      }
    },
    "docs.renewal.step.1": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta el iPhone a la computadora donde tienes Sideloadly."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect the iPhone to the computer where you have Sideloadly."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte o iPhone ao computador onde está o Sideloadly."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Branchez l’iPhone à l’ordinateur où se trouve Sideloadly."
          }
        }
      }
    },
    "docs.renewal.step.2": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra de nuevo **Hoply.ipa** e inicia sesión con el mismo Apple ID."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag **Hoply.ipa** in again and sign in with the same Apple ID."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste **Hoply.ipa** novamente e entre com o mesmo Apple ID."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glissez de nouveau **Hoply.ipa** et connectez-vous avec le même identifiant Apple."
          }
        }
      }
    },
    "docs.renewal.step.3": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la app: la fecha de caducidad se actualiza en la pantalla principal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the app: the expiry date updates on the main screen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o app: a data de expiração é atualizada na tela principal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez l’app : la date d’expiration se met à jour sur l’écran principal."
          }
        }
      }
    },
    "docs.renewal.summary": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La firma gratuita dura 7 días"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The free signature lasts 7 days"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A assinatura gratuita dura 7 dias"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La signature gratuite dure 7 jours"
          }
        }
      }
    },
    "docs.renewal.title": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Renovar la instalación"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Renew the installation"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Renovar a instalação"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renouveler l’installation"
          }
        }
      }
    },
    "docs.systemWide.guide": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La guía completa está en **Docs/tun2socks.md** del repositorio."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The full guide is in the repository's **Docs/tun2socks.md**."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O guia completo está em **Docs/tun2socks.md** no repositório."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le guide complet se trouve dans **Docs/tun2socks.md** du dépôt."
          }
        }
      }
    },
    "docs.systemWide.intro": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proxy funciona con todo lo que respeta la configuración de proxy: navegadores, la mayoría de las apps y las herramientas de consola con variables de entorno."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The proxy works with everything that honors the proxy settings: browsers, most apps and command-line tools with environment variables."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O proxy funciona com tudo que respeita a configuração de proxy: navegadores, a maioria dos apps e ferramentas de linha de comando com variáveis de ambiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le proxy fonctionne avec tout ce qui respecte les réglages de proxy : navigateurs, la plupart des apps et les outils en ligne de commande via les variables d’environnement."
          }
        }
      }
    },
    "docs.systemWide.summary": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps que ignoran el proxy"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps that ignore the proxy"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps que ignoram o proxy"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps qui ignorent le proxy"
          }
        }
      }
    },
    "docs.systemWide.title": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo el sistema"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System-wide"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo o sistema"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout le système"
          }
        }
      }
    },
    "docs.systemWide.when": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas apps de escritorio, juegos y VPN ignoran el proxy. Para ellas se puede crear un adaptador de red virtual con tun2socks que envía todo el tráfico TCP por Hoply."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some desktop apps, games and VPNs ignore the proxy. For those you can create a virtual network adapter with tun2socks that sends all TCP traffic through Hoply."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns apps de computador, jogos e VPNs ignoram o proxy. Para eles, você pode criar um adaptador de rede virtual com o tun2socks que envia todo o tráfego TCP pelo Hoply."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines apps pour ordinateur, certains jeux et VPN ignorent le proxy. Pour eux, vous pouvez créer une carte réseau virtuelle avec tun2socks qui envoie tout le trafic TCP par Hoply."
          }
        }
      }
    },
    "docs.terminal.intro": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muchas herramientas de consola ignoran el proxy del sistema pero leen estas variables. Ejecuta la línea en cada terminal nueva, o agrégala a tu perfil."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Many command-line tools ignore the system proxy but read these variables. Run the line in each new terminal, or add it to your profile."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muitas ferramentas de linha de comando ignoram o proxy do sistema, mas leem estas variáveis. Execute a linha em cada terminal novo ou adicione-a ao seu perfil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beaucoup d’outils en ligne de commande ignorent le proxy du système mais lisent ces variables. Exécutez la ligne dans chaque nouveau terminal ou ajoutez-la à votre profil."
          }
        }
      }
    },
    "docs.terminal.posix": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS y Linux"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS and Linux"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS e Linux"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS et Linux"
          }
        }
      }
    },
    "docs.terminal.socks": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con **socks5h** los nombres se resuelven en el iPhone, así que el DNS también sale por los datos móviles."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With **socks5h** names are resolved on the iPhone, so DNS also goes over mobile data."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com **socks5h** os nomes são resolvidos no iPhone, então o DNS também passa pelos dados móveis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec **socks5h**, les noms sont résolus sur l’iPhone : le DNS passe aussi par les données mobiles."
          }
        }
      }
    },
