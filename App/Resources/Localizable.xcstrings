    "docs.trouble.ignoresProxy": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configúrala a mano con la dirección del proxy, usa las variables de la sección Terminal o consulta Todo el sistema."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set it up manually with the proxy address, use the variables from the Terminal section or see System-wide."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure-o manualmente com o endereço do proxy, use as variáveis da seção Terminal ou veja Todo o sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurez-la à la main avec l’adresse du proxy, utilisez les variables de la section Terminal ou consultez Tout le système."
          }
        }
      }
    },
    "docs.trouble.ignoresProxy.title": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una app no usa el proxy"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An app doesn't use the proxy"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um app não usa o proxy"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une app n’utilise pas le proxy"
          }
        }
      }
    },
    "docs.trouble.noDevice": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea el iPhone, reconecta el cable y toca **Confiar**. En Windows instala Apple Devices o iTunes; en Linux, usbmuxd. Prueba otro cable o puerto USB."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock the iPhone, reconnect the cable and tap **Trust**. On Windows install Apple Devices or iTunes; on Linux, usbmuxd. Try another cable or USB port."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueie o iPhone, reconecte o cabo e toque em **Confiar**. No Windows, instale Dispositivos Apple ou o iTunes; no Linux, o usbmuxd. Tente outro cabo ou outra porta USB."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déverrouillez l’iPhone, rebranchez le câble et touchez **Se fier**. Sous Windows, installez Appareils Apple ou iTunes ; sous Linux, usbmuxd. Essayez un autre câble ou un autre port USB."
          }
        }
      }
    },
    "docs.trouble.noDevice.title": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La laptop no detecta el iPhone"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The laptop doesn't detect the iPhone"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O laptop não detecta o iPhone"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ordinateur ne détecte pas l’iPhone"
          }
        }
      }
    },
    "docs.trouble.noInternet": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba que el proxy esté **Activo** aquí, que haya datos móviles y que el puerto sea el mismo en ambas apps. Revisa **Actividad** para ver los errores recientes."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure the proxy is **Running** here, there's mobile data and the port matches in both apps. Check **Activity** for recent errors."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique se o proxy está **Em execução** aqui, se há dados móveis e se a porta é a mesma nos dois apps. Veja erros recentes em **Atividade**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez que le proxy est **En marche** ici, qu’il y a des données mobiles et que le port est le même dans les deux apps. Consultez **Activité** pour les erreurs récentes."
          }
        }
      }
    },
    "docs.trouble.noInternet.title": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectado pero sin internet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected but no internet"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectado, mas sem internet"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecté mais sans internet"
          }
        }
      }
    },
    "docs.trouble.portInUse": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otro programa usa el puerto 1080 en la laptop, por ejemplo un «ios forward» que quedó abierto. Ciérralo o cambia el puerto en Ajustes y en la app de escritorio."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another program uses port 1080 on the laptop, for example a leftover “ios forward”. Close it or change the port in Settings and in the desktop app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outro programa usa a porta 1080 no laptop, por exemplo um “ios forward” que ficou aberto. Feche-o ou mude a porta em Ajustes e no app para computador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre programme utilise le port 1080 sur l’ordinateur, par exemple un « ios forward » resté ouvert. Fermez-le ou changez le port dans Réglages et dans l’app pour ordinateur."
          }
        }
      }
    },
    "docs.trouble.portInUse.title": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El puerto está en uso"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The port is in use"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A porta está em uso"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le port est déjà utilisé"
          }
        }
      }
    },
    "docs.trouble.screenLock": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS suspende las apps en segundo plano. Mantén la app abierta o activa **Ajustes > Seguir activo con la pantalla bloqueada** (experimental)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS suspends background apps. Keep the app open or turn on **Settings > Keep running with the screen locked** (experimental)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS suspende os apps em segundo plano. Mantenha o app aberto ou ative **Ajustes > Continuar com a tela bloqueada** (experimental)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS suspend les apps en arrière-plan. Gardez l’app ouverte ou activez **Réglages > Continuer écran verrouillé** (expérimental)."
          }
        }
      }
    },
    "docs.trouble.screenLock.title": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se corta al bloquear la pantalla"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It drops when the screen locks"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cai quando a tela bloqueia"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ça coupe quand l’écran se verrouille"
          }
        }
      }
    },
    "docs.trouble.udp": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoply solo transporta TCP. Lo que depende de UDP, como ping, muchos juegos y algunas videollamadas, puede no funcionar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoply only carries TCP. Anything that relies on UDP, such as ping, many games and some video calls, may not work."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Hoply só transporta TCP. O que depende de UDP, como ping, muitos jogos e algumas videochamadas, pode não funcionar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoply ne transporte que le TCP. Ce qui dépend de l’UDP, comme le ping, beaucoup de jeux et certains appels vidéo, peut ne pas fonctionner."
          }
        }
      }
    },
    "docs.trouble.udp.title": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Videollamadas o juegos no funcionan"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Video calls or games don't work"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Videochamadas ou jogos não funcionam"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les appels vidéo ou les jeux ne marchent pas"
          }
        }
      }
    },
